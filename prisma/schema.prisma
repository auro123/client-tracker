generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          String    @id @default(cuid())
  name        String
  clientName  String
  pipelineId  String    @default("client-onboarding")
  stageId     String
  notes       String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tasks       Task[]
  stageEvents StageEvent[]

  @@index([archivedAt])
}

model Task {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  statusId    String    @default("todo")
  dueDate     DateTime? @db.Date
  sortOrder   Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId, statusId])
  @@index([dueDate])
}

model StageEvent {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stageId   String
  enteredAt DateTime @default(now())

  @@index([projectId, enteredAt])
}
